# 17. MACHINE LEARNING
#     RESTAURANT RATING PREDICTION
# ============================

print("\n" + "=" * 65)
print("15. MACHINE LEARNING MODEL")
print("=" * 65)

model = None
ml_results = {}

if rating_col:

    ml_df = df.copy()

    ml_df[rating_col] = pd.to_numeric(
        ml_df[rating_col],
        errors="coerce"
    )

    ml_df = ml_df.dropna(subset=[rating_col])

    # Select useful predictors
    candidate_features = [
        city_col,
        cuisine_col,
        cost_col,
        votes_col,
        online_col,
        table_col
    ]

    feature_columns = [
        col for col in candidate_features
        if col is not None and col != rating_col
    ]

    # Remove duplicate column names
    feature_columns = list(dict.fromkeys(feature_columns))

    # Remove features with no useful variation
    feature_columns = [
        col for col in feature_columns
        if ml_df[col].nunique(dropna=True) > 1
    ]

    if len(feature_columns) > 0 and len(ml_df) >= 20:

        X = ml_df[feature_columns].copy()
        y = ml_df[rating_col].copy()

        # Detect numeric and categorical columns
        numeric_features = X.select_dtypes(
            include=np.number
        ).columns.tolist()

        categorical_features = [
            col for col in X.columns
            if col not in numeric_features
        ]

        numeric_transformer = Pipeline(steps=[
            ("imputer", SimpleImputer(strategy="median")),
            ("scaler", StandardScaler())
        ])

        categorical_transformer = Pipeline(steps=[
            ("imputer", SimpleImputer(strategy="most_frequent")),
            ("encoder", OneHotEncoder(handle_unknown="ignore"))
        ])

        transformers = []

        if numeric_features:
            transformers.append(
                ("numeric", numeric_transformer, numeric_features)
            )

        if categorical_features:
            transformers.append(
                ("categorical", categorical_transformer,
                 categorical_features)
            )

        preprocessor = ColumnTransformer(
            transformers=transformers
        )

        model = Pipeline(steps=[
            ("preprocessor", preprocessor),
            ("regressor", RandomForestRegressor(
                n_estimators=100,
                random_state=42,
                n_jobs=-1
            ))
        ])

        X_train, X_test, y_train, y_test = train_test_split(
            X,
            y,
            test_size=0.20,
            random_state=42
        )

        model.fit(X_train, y_train)

        y_pred = model.predict(X_test)

        mae = mean_absolute_error(y_test, y_pred)
        rmse = np.sqrt(mean_squared_error(y_test, y_pred))
        r2 = r2_score(y_test, y_pred)

        ml_results = {
            "MAE": mae,
            "RMSE": rmse,
            "R2 Score": r2
        }

        print("\nModel Training Completed!")

        print("Training Records:", len(X_train))
        print("Testing Records:", len(X_test))

        print("\nModel Evaluation:")

        print("Mean Absolute Error:", round(mae, 3))
        print("Root Mean Squared Error:", round(rmse, 3))
        print("R2 Score:", round(r2, 3))

        # Actual vs Predicted visualization

        plt.figure(figsize=(7, 5))

        plt.scatter(y_test, y_pred)

        plt.xlabel("Actual Rating")
        plt.ylabel("Predicted Rating")

        plt.title("Actual vs Predicted Restaurant Ratings")

        plt.tight_layout()
        plt.show()

    else:

        print(
            "Machine Learning skipped: "
            "Not enough valid records or useful predictor columns."
        )

else:

